    {
      "id": "531a6e2c-f408-458e-848a-6e275cb60aaa",
      "name": "Create Chunks",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2352,
        1440
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const input = $(\"Validate Input\").first().json;\nconst doc = $input.first().json;\n\nconst text = (input.content || \"\").trim();\nconst chunkSize = 1200;\nconst overlap = 200;\n\nconst chunks = [];\nlet start = 0;\nlet chunkIndex = 0;\n\nwhile (start < text.length) {\n  let end = Math.min(start + chunkSize, text.length);\n\n  if (end < text.length) {\n    const paragraphBreak = text.lastIndexOf(\"\\n\\n\", end);\n    const sentenceBreak = text.lastIndexOf(\". \", end);\n    if (paragraphBreak > start + 600) {\n      end = paragraphBreak + 2;\n    } else if (sentenceBreak > start + 600) {\n      end = sentenceBreak + 2;\n    }\n  }\n\n  const chunk = text.slice(start, end).trim();\n  if (chunk) {\n    chunks.push({\n      document_id: doc.id,\n      chunk_index: chunkIndex,\n      content: chunk,\n      metadata: { title: input.title },\n    });\n    chunkIndex++;\n  }\n\n  if (end >= text.length) break;\n  start = Math.max(end - overlap, start + 1);\n}\n\nif (chunks.length === 0) {\n  throw new Error(\"No chunks were produced from the document content\");\n}\n\nreturn chunks.map((c) => ({ json: c }));"
      }
    },

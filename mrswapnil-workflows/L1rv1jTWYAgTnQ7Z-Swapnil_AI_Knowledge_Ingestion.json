      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const input = $input.first().json || {};\n\nconst title = (input.title ?? \"\").toString().trim();\nconst source_type = (input.source_type ?? \"\").toString().trim();\nconst content = (input.content ?? \"\").toString();\n\nconst errors = [];\nif (!title) errors.push(\"title is required\");\nif (!source_type) errors.push(\"source_type is required\");\nif (!content.trim()) errors.push(\"content is required\");\nif (errors.length) {\n  throw new Error(\"Knowledge Ingestion input validation failed: \" + errors.join(\"; \"));\n}\n\n// UUID fields must be null, never an empty string\nlet project_id = input.project_id;\nif (project_id === undefined || project_id === null || project_id.toString().trim() === \"\") {\n  project_id = null;\n} else {\n  project_id = project_id.toString().trim();\n}\n\nreturn [{\n  json: {\n    title,\n    description: (input.description ?? \"\").toString(),\n    source_type,\n    source_url: (input.source_url ?? \"\").toString(),\n    file_path: (input.file_path ?? \"\").toString(),\n    project_id,\n    content,\n  },\n}];"
      }
    },
